<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Generated/AutoSDK.SharedJsonMetadata.props" Condition="Exists('Generated/AutoSDK.SharedJsonMetadata.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Description>C# SDK based on DId OpenAPI specification.</Description>
    <PackageTags>d-id;ai;video-generation;talking-avatar;sdk;csharp;dotnet;openapi;autosdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoSDK.JsonMetadata" Version="$(AutoSDKJsonMetadataVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
  </ItemGroup>

</Project>
